#-----------------------------------------------------------------------------
# Create counts for sensitivity analysis that considers paths that start
# from the source sense or a synonym of the source sense.
#
# See `count_tr_sense_top_langs.rq` for other optimization and
# organization comments.
#-----------------------------------------------------------------------------

PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT ?lang ?targ
       (count(*) as ?nSense)
       (sum(?meetsIFTS) as ?nsIFTS)
       (sum(?meetsTransToL2) as ?nsTransToL2)
       (sum(?meetsTrans2ToL2) as ?nsTrans2ToL2)
       (sum(?meetsDemonym) as ?nsDemonym)
       (sum(?meetsPredicateFor) as ?nsPredicateFor)
       (sum(?meetsAny) as ?nsAny)
WHERE {

  { SELECT ?lang (COUNT(*) as ?count)
    WHERE { ?sense ^ontolex:sense / dct:language ?lang }
    GROUP BY ?lang
    ORDER BY DESC(?count)
    LIMIT 50
  }
  { SELECT ?targ (COUNT(*) as ?count2)
    WHERE { ?sense ^ontolex:sense / dct:language ?targ }
    GROUP BY ?targ
    ORDER BY DESC(?count2)
    LIMIT 50
  }

  ?sense a ontolex:LexicalSense ;
         ^ontolex:sense [ dct:language ?lang ] .

  BIND(IF(EXISTS {
       ?sense  wdt:P5973? / wdt:P5137 / ^wdt:P5137 / ^ontolex:sense / dct:language ?targ .
                 }, 1, 0) AS ?meetsIFTS)

  BIND(IF(EXISTS {
       ?sense  wdt:P5973? / wdt:P5972 / ^ontolex:sense / dct:language ?targ .
                 }, 1, 0) AS ?meetsTransToL2)

  BIND(IF(EXISTS {
       ?sense  wdt:P5973? / wdt:P5972 / wdt:P5972? / ^ontolex:sense / dct:language ?targ .
                 }, 1, 0) AS ?meetsTrans2ToL2)

  BIND(IF(EXISTS {
       ?sense  wdt:P5973? / wdt:P6271 / ^wdt:P6271 / ^ontolex:sense / dct:language ?targ .
                 }, 1, 0) AS ?meetsDemonym)

  BIND(IF(EXISTS {
       ?sense  wdt:P5973? / wdt:P9970 / ^wdt:P9970 / ^ontolex:sense / dct:language ?targ .
                 }, 1, 0) AS ?meetsPredicateFor)

  BIND(IF( ?meetsIFTS = 1    || ?meetsTransToL2 = 1 || ?meetsTrans2ToL2 = 1 ||
           ?meetsDemonym = 1 || ?meetsPredicateFor = 1, 1, 0) AS ?meetsAny)

}
GROUP BY ?lang ?targ
